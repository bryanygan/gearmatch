# PricesAPI key for price update scripts (update-prices.ts, update-mice-prices.ts)
# Get a key at https://pricesapi.io
PRICES_API_KEY=pricesapi_your_key_here

# Walmart Affiliate API
# Generate SSH keys: ssh-keygen -t rsa -b 3072 -f ~/.ssh/walmart_production
# Upload public key (PKCS8 format) at developer.walmart.com
WALMART_CONSUMER_ID_PROD=your_production_consumer_id
WALMART_CONSUMER_ID_STAGE=your_stage_consumer_id
WALMART_KEY_FILE_PROD=~/.ssh/walmart_production
WALMART_KEY_FILE_STAGE=~/.ssh/walmart_sandbox
